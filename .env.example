 1: # MiniBot Environment Variables
 2: # Copy this file to .env and fill in your values
 3: 
 4: # OpenAI
 5: OPENAI_API_KEY=
 6: OPENAI_BASE_URL=
 7: 
 8: # Google Gemini
 9: GEMINI_API_KEY=
10: 
11: # NVIDIA NIM
12: NVIDIA_API_KEY=
13: 
14: # Lark (Feishu)
15: LARK_APP_ID=
16: LARK_APP_SECRET=
17: 
18: # Search API (Tavily)
19: TAVILY_API_KEY=
20: 
21: # Working directory for file operations
22: MINIBOT_WORK_DIR=./workspace
